;; The async ABI (#16) on the host boundary: a callback-ABI export, stackful exports, and streams and
;; futures in both directions. A task can outlive its call (it keeps writing after `task.return`), so
;; the callback tasks keep their state in memory that the task's `context` slot 0 points to.
(component
  (type $ST (stream u32))
  (type $FT (future u32))

  (core module $Mem (memory (export "mem") 1))
  (core instance $mem (instantiate $Mem))

  (core module $M
    (import "" "mem" (memory 1))
    (import "" "task.return.u32" (func $return-u32 (param i32)))
    (import "" "task.return.stream" (func $return-stream (param i32)))
    (import "" "task.return.future" (func $return-future (param i32)))
    (import "" "stream.new" (func $stream.new (result i64)))
    (import "" "stream.write" (func $stream.write (param i32 i32 i32) (result i32)))
    (import "" "stream.read" (func $stream.read (param i32 i32 i32) (result i32)))
    (import "" "stream.drop-writable" (func $stream.drop-writable (param i32)))
    (import "" "stream.drop-readable" (func $stream.drop-readable (param i32)))
    (import "" "future.new" (func $future.new (result i64)))
    (import "" "future.write" (func $future.write (param i32 i32) (result i32)))
    (import "" "future.read" (func $future.read (param i32 i32) (result i32)))
    (import "" "future.drop-writable" (func $future.drop-writable (param i32)))
    (import "" "future.drop-readable" (func $future.drop-readable (param i32)))
    (import "" "waitable-set.new" (func $waitable-set.new (result i32)))
    (import "" "waitable-set.drop" (func $waitable-set.drop (param i32)))
    (import "" "waitable.join" (func $waitable.join (param i32 i32)))
    (import "" "context.get" (func $context.get (result i32)))
    (import "" "context.set" (func $context.set (param i32)))

    (global $x (mut i32) (i32.const 0))
    ;; Bump allocator for the tasks' state (never freed: the tests make few calls).
    (global $heap (mut i32) (i32.const 8192))

    ;; A task's state: writer end (+0), waitable set (+4), values to write (+8), values written (+12).
    (func $new-state (result i32)
      (local $p i32)
      (local.set $p (global.get $heap))
      (global.set $heap (i32.add (global.get $heap) (i32.const 16)))
      (call $context.set (local.get $p))
      (local.get $p))
    (func $writer (result i32) (i32.load offset=0 (call $context.get)))
    (func $ws (result i32) (i32.load offset=4 (call $context.get)))
    (func $n (result i32) (i32.load offset=8 (call $context.get)))
    (func $written (result i32) (i32.load offset=12 (call $context.get)))
    (func $set-written (param i32) (i32.store offset=12 (call $context.get) (local.get 0)))

    ;; double(x): yields once (callback ABI), then returns 2 * x.
    (func (export "double") (param $x i32) (result i32)
      (global.set $x (local.get $x))
      (i32.const 1 (; YIELD ;)))
    (func (export "double-cb") (param i32 i32 i32) (result i32)
      (call $return-u32 (i32.mul (global.get $x) (i32.const 2)))
      (i32.const 0 (; EXIT ;)))

    ;; count-up(n): returns a stream, then writes 0, 1, ..., n - 1 to it and drops it.
    (func (export "count-up") (param $n i32) (result i32)
      (local $i i32)
      (local $ends i64)
      (block $done
        (loop $fill
          (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (i32.store (i32.add (i32.const 1024) (i32.shl (local.get $i) (i32.const 2))) (local.get $i))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $fill)))
      (local.set $i (call $new-state))
      (i32.store offset=8 (local.get $i) (local.get $n))
      (local.set $ends (call $stream.new))
      (i32.store offset=0 (local.get $i) (i32.wrap_i64 (i64.shr_u (local.get $ends) (i64.const 32))))
      (i32.store offset=4 (local.get $i) (call $waitable-set.new))
      (call $waitable.join (call $writer) (call $ws))
      (call $return-stream (i32.wrap_i64 (local.get $ends)))
      (call $write-rest))
    (func $write-rest (result i32)
      (local $ret i32)
      (loop $again
        (if (i32.ge_u (call $written) (call $n))
          (then
            (call $waitable.join (call $writer) (i32.const 0))
            (call $waitable-set.drop (call $ws))
            (call $stream.drop-writable (call $writer))
            (return (i32.const 0 (; EXIT ;)))))
        (local.set $ret
          (call $stream.write
            (call $writer)
            (i32.add (i32.const 1024) (i32.shl (call $written) (i32.const 2)))
            (i32.sub (call $n) (call $written))))
        (if (i32.eq (local.get $ret) (i32.const -1 (; BLOCKED ;)))
          (then (return (i32.or (i32.const 2 (; WAIT ;)) (i32.shl (call $ws) (i32.const 4))))))
        (br_if $again (call $progress (local.get $ret))))
      (i32.const 0))
    ;; Counts the values a write copied; false once the reader dropped its end.
    (func $progress (param $result i32) (result i32)
      (call $set-written (i32.add (call $written) (i32.shr_u (local.get $result) (i32.const 4))))
      (if (i32.ne (i32.and (local.get $result) (i32.const 0xf)) (i32.const 0 (; COMPLETED ;)))
        (then (call $set-written (call $n))))
      (i32.const 1))
    (func (export "count-up-cb") (param $event i32) (param $handle i32) (param $result i32) (result i32)
      (drop (call $progress (local.get $result)))
      (call $write-rest))

    ;; sum(s): reads the stream to its end, four values at a time (stackful ABI).
    (func (export "sum") (param $s i32)
      (local $total i32)
      (local $ret i32)
      (local $k i32)
      (local $i i32)
      (loop $read
        (local.set $ret (call $stream.read (local.get $s) (i32.const 2048) (i32.const 4)))
        (local.set $k (i32.shr_u (local.get $ret) (i32.const 4)))
        (local.set $i (i32.const 0))
        (block $done
          (loop $add
            (br_if $done (i32.ge_u (local.get $i) (local.get $k)))
            (local.set $total
              (i32.add (local.get $total) (i32.load (i32.add (i32.const 2048) (i32.shl (local.get $i) (i32.const 2))))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $add)))
        (br_if $read (i32.eqz (i32.and (local.get $ret) (i32.const 0xf)))))
      (call $stream.drop-readable (local.get $s))
      (call $return-u32 (local.get $total)))

    ;; later(x): returns a future, then resolves it to x + 1.
    (func (export "later") (param $x i32) (result i32)
      (local $ends i64)
      (local $ret i32)
      (local $p i32)
      (local.set $p (call $new-state))
      ;; The value is written from the state's +8.
      (i32.store offset=8 (local.get $p) (i32.add (local.get $x) (i32.const 1)))
      (local.set $ends (call $future.new))
      (i32.store offset=0 (local.get $p) (i32.wrap_i64 (i64.shr_u (local.get $ends) (i64.const 32))))
      (call $return-future (i32.wrap_i64 (local.get $ends)))
      (local.set $ret (call $future.write (call $writer) (i32.add (local.get $p) (i32.const 8))))
      (if (i32.eq (local.get $ret) (i32.const -1 (; BLOCKED ;)))
        (then
          (i32.store offset=4 (local.get $p) (call $waitable-set.new))
          (call $waitable.join (call $writer) (call $ws))
          (return (i32.or (i32.const 2 (; WAIT ;)) (i32.shl (call $ws) (i32.const 4))))))
      (call $future.drop-writable (call $writer))
      (i32.const 0 (; EXIT ;)))
    (func (export "later-cb") (param i32 i32 i32) (result i32)
      (call $waitable.join (call $writer) (i32.const 0))
      (call $waitable-set.drop (call $ws))
      (call $future.drop-writable (call $writer))
      (i32.const 0 (; EXIT ;)))

    ;; times-ten(f): waits for the future (stackful ABI) and returns 10 times its value.
    (func (export "times-ten") (param $f i32)
      (drop (call $future.read (local.get $f) (i32.const 3584)))
      (call $future.drop-readable (local.get $f))
      (call $return-u32 (i32.mul (i32.load (i32.const 3584)) (i32.const 10))))
  )

  (canon task.return (result u32) (core func $return-u32))
  (canon task.return (result $ST) (core func $return-stream))
  (canon task.return (result $FT) (core func $return-future))
  (canon stream.new $ST (core func $stream.new))
  (canon stream.write $ST async (memory (core memory $mem "mem")) (core func $stream.write))
  (canon stream.read $ST (memory (core memory $mem "mem")) (core func $stream.read))
  (canon stream.drop-writable $ST (core func $stream.drop-writable))
  (canon stream.drop-readable $ST (core func $stream.drop-readable))
  (canon future.new $FT (core func $future.new))
  (canon future.write $FT async (memory (core memory $mem "mem")) (core func $future.write))
  (canon future.read $FT (memory (core memory $mem "mem")) (core func $future.read))
  (canon future.drop-writable $FT (core func $future.drop-writable))
  (canon future.drop-readable $FT (core func $future.drop-readable))
  (canon waitable-set.new (core func $waitable-set.new))
  (canon waitable-set.drop (core func $waitable-set.drop))
  (canon waitable.join (core func $waitable.join))
  (canon context.get i32 0 (core func $context.get))
  (canon context.set i32 0 (core func $context.set))
  (core instance $m (instantiate $M (with "" (instance
    (export "mem" (memory $mem "mem"))
    (export "task.return.u32" (func $return-u32))
    (export "task.return.stream" (func $return-stream))
    (export "task.return.future" (func $return-future))
    (export "stream.new" (func $stream.new))
    (export "stream.write" (func $stream.write))
    (export "stream.read" (func $stream.read))
    (export "stream.drop-writable" (func $stream.drop-writable))
    (export "stream.drop-readable" (func $stream.drop-readable))
    (export "future.new" (func $future.new))
    (export "future.write" (func $future.write))
    (export "future.read" (func $future.read))
    (export "future.drop-writable" (func $future.drop-writable))
    (export "future.drop-readable" (func $future.drop-readable))
    (export "waitable-set.new" (func $waitable-set.new))
    (export "waitable-set.drop" (func $waitable-set.drop))
    (export "waitable.join" (func $waitable.join))
    (export "context.get" (func $context.get))
    (export "context.set" (func $context.set))
  ))))

  (func (export "double") async (param "x" u32) (result u32)
    (canon lift (core func $m "double") async (callback (core func $m "double-cb"))))
  (func (export "count-up") async (param "n" u32) (result $ST)
    (canon lift (core func $m "count-up") async (callback (core func $m "count-up-cb"))))
  (func (export "sum") async (param "s" $ST) (result u32)
    (canon lift (core func $m "sum") async))
  (func (export "later") async (param "x" u32) (result $FT)
    (canon lift (core func $m "later") async (callback (core func $m "later-cb"))))
  (func (export "times-ten") async (param "f" $FT) (result u32)
    (canon lift (core func $m "times-ten") async))
)
