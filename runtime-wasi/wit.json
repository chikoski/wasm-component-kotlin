    {
      "name": "stdin",
      "types": {
        "error-code": 16
      },
      "functions": {
        "read-via-stream": {
          "name": "read-via-stream",
          "kind": "freestanding",
          "params": [],
          "result": 20,
          "docs": {
            "contents": "Return a stream for reading from stdin.\n\nThis function returns a stream which provides data read from stdin,\nand a future to signal read results.\n\nIf the stream's readable end is dropped the future will resolve to success.\n\nIf the stream's writable end is dropped the future will either resolve to\nsuccess if stdin was closed by the writer or to an error-code if reading\nfailed for some other reason.\n\nMultiple streams may be active at the same time. The behavior of concurrent\nreads is implementation-specific."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        }
      },
      "stability": {
        "stable": {
          "since": "0.3.0"
        }
      },
      "package": 2
