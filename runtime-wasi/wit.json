          "params": [
            {
              "name": "data",
              "type": 17
            }
          ],
          "result": 23,
          "docs": {
            "contents": "Write the given stream to stdout.\n\nIf the stream's writable end is dropped this function will either return\nsuccess once the entire contents of the stream have been written or an\nerror-code representing a failure.\n\nOtherwise if there is an error the readable end of the stream will be\ndropped and this function will return an error-code."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        }
      },
      "stability": {
