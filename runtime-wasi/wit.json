    {
      "name": "monotonic-clock",
      "types": {
        "duration": 1,
        "mark": 2
      },
      "functions": {
        "now": {
          "name": "now",
          "kind": "freestanding",
          "params": [],
          "result": 2,
          "docs": {
            "contents": "Read the current value of the clock.\n\nThe clock is monotonic, therefore calling this function repeatedly will\nproduce a sequence of non-decreasing values.\n\nFor completeness, this function traps if it's not possible to represent\nthe value of the clock in a `mark`. Consequently, implementations\nshould ensure that the starting time is low enough to avoid the\npossibility of overflow in practice."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        },
        "get-resolution": {
          "name": "get-resolution",
          "kind": "freestanding",
          "params": [],
          "result": 1,
          "docs": {
            "contents": "Query the resolution of the clock. Returns the duration of time\ncorresponding to a clock tick."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        },
        "wait-until": {
          "name": "wait-until",
          "kind": "async-freestanding",
          "params": [
            {
              "name": "when",
              "type": 2
            }
          ],
          "docs": {
            "contents": "Wait until the specified mark has occurred."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        },
        "wait-for": {
          "name": "wait-for",
          "kind": "async-freestanding",
          "params": [
            {
              "name": "how-long",
              "type": 1
            }
          ],
          "docs": {
            "contents": "Wait for the specified duration to elapse."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        }
      },
      "docs": {
        "contents": "WASI Monotonic Clock is a clock API intended to let users measure elapsed\ntime.\n\nIt is intended to be portable at least between Unix-family platforms and\nWindows.\n\nA monotonic clock is a clock which has an unspecified initial value, and\nsuccessive reads of the clock will produce non-decreasing values."
      },
      "stability": {
        "stable": {
          "since": "0.3.0"
        }
      },
      "package": 0
    },
    {
      "name": "system-clock",
      "types": {
        "duration": 3,
        "instant": 4
      },
      "functions": {
        "now": {
          "name": "now",
          "kind": "freestanding",
          "params": [],
          "result": 4,
          "docs": {
            "contents": "Read the current value of the clock.\n\nThis clock is not monotonic, therefore calling this function repeatedly\nwill not necessarily produce a sequence of non-decreasing values.\n\nThe nanoseconds field of the output is always less than 1000000000."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        },
        "get-resolution": {
          "name": "get-resolution",
          "kind": "freestanding",
          "params": [],
          "result": 3,
          "docs": {
            "contents": "Query the resolution of the clock. Returns the smallest duration of time\nthat the implementation permits distinguishing."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        }
      },
      "docs": {
        "contents": "WASI System Clock is a clock API intended to let users query the current\ntime. The clock is not necessarily monotonic as it may be reset.\n\nIt is intended to be portable at least between Unix-family platforms and\nWindows.\n\nExternal references may be reset, so this clock is not necessarily\nmonotonic, making it unsuitable for measuring elapsed time.\n\nIt is intended for reporting the current date and time for humans."
      },
      "stability": {
        "stable": {
          "since": "0.3.0"
        }
      },
      "package": 0
    },
    {
      "name": "timezone",
      "types": {
        "instant": 5
      },
      "functions": {
        "iana-id": {
          "name": "iana-id",
          "kind": "freestanding",
          "params": [],
          "result": 6,
          "docs": {
            "contents": "Return the IANA identifier of the currently configured timezone. This\nshould be an identifier from the IANA Time Zone Database.\n\nFor displaying to a user, the identifier should be converted into a\nlocalized name by means of an internationalization API.\n\nIf the implementation does not expose an actual timezone, or is unable\nto provide mappings from times to deltas between the configured timezone\nand UTC, or determining the current timezone fails, or the timezone does\nnot have an IANA identifier, this returns nothing."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        },
        "utc-offset": {
          "name": "utc-offset",
          "kind": "freestanding",
          "params": [
            {
              "name": "when",
              "type": 5
            }
          ],
          "result": 7,
          "docs": {
            "contents": "The number of nanoseconds difference between UTC time and the local\ntime of the currently configured timezone, at the exact time of\n`instant`.\n\nThe magnitude of the returned value will always be less than\n86,400,000,000,000 which is the number of nanoseconds in a day\n(24*60*60*1e9).\n\nIf the implementation does not expose an actual timezone, or is unable\nto provide mappings from times to deltas between the configured timezone\nand UTC, or determining the current timezone fails, this returns\nnothing."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        },
        "to-debug-string": {
          "name": "to-debug-string",
          "kind": "freestanding",
          "params": [],
          "result": "string",
          "docs": {
            "contents": "Returns a string that is suitable to assist humans in debugging whether\nany timezone is available, and if so, which. This may be the same string\nas `iana-id`, or a formatted representation of the UTC offset such as\n`-04:00`, or something else.\n\nWARNING: The returned string should not be consumed mechanically! It may\nchange across platforms, hosts, or other implementation details. Parsing\nthis string is a major platform-compatibility hazard."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        }
      },
      "stability": {
        "stable": {
          "since": "0.3.0"
        }
      },
      "package": 0
    },
    {
      "name": "insecure-seed",
      "types": {},
      "functions": {
        "get-insecure-seed": {
          "name": "get-insecure-seed",
          "kind": "freestanding",
          "params": [],
          "result": 8,
          "docs": {
            "contents": "Return a 128-bit value that may contain a pseudo-random value.\n\nThe returned value is not required to be computed from a CSPRNG, and may\neven be entirely deterministic. Host implementations are encouraged to\nprovide pseudo-random values to any program exposed to\nattacker-controlled content, to enable DoS protection built into many\nlanguages' hash-map implementations.\n\nThis function is intended to only be called once, by a source language\nto initialize Denial Of Service (DoS) protection in its hash-map\nimplementation.\n\n# Expected future evolution\n\nThis will likely be changed to a value import, to prevent it from being\ncalled multiple times and potentially used for purposes other than DoS\nprotection."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        }
      },
      "docs": {
        "contents": "The insecure-seed interface for seeding hash-map DoS resistance.\n\nIt is intended to be portable at least between Unix-family platforms and\nWindows."
      },
      "stability": {
        "stable": {
          "since": "0.3.0"
        }
      },
      "package": 1
    },
    {
      "name": "insecure",
      "types": {},
      "functions": {
        "get-insecure-random-bytes": {
          "name": "get-insecure-random-bytes",
          "kind": "freestanding",
          "params": [
            {
              "name": "max-len",
              "type": "u64"
            }
          ],
          "result": 9,
          "docs": {
            "contents": "Return up to `max-len` insecure pseudo-random bytes.\n\nThis function is not cryptographically secure. Do not use it for\nanything related to security.\n\nThere are no requirements on the values of the returned bytes, however\nimplementations are encouraged to return evenly distributed values with\na long period.\n\nImplementations MAY return fewer bytes than requested (a short read).\nCallers that require exactly `max-len` bytes MUST call this function in\na loop until the desired number of bytes has been accumulated.\nImplementations MUST return at least 1 byte when `max-len` is greater\nthan zero. When `max-len` is zero, implementations MUST return an empty\nlist without trapping."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        },
        "get-insecure-random-u64": {
          "name": "get-insecure-random-u64",
          "kind": "freestanding",
          "params": [],
          "result": "u64",
          "docs": {
            "contents": "Return an insecure pseudo-random `u64` value.\n\nThis function returns the same type of pseudo-random data as\n`get-insecure-random-bytes`, represented as a `u64`."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        }
      },
      "docs": {
        "contents": "The insecure interface for insecure pseudo-random numbers.\n\nIt is intended to be portable at least between Unix-family platforms and\nWindows."
      },
      "stability": {
        "stable": {
          "since": "0.3.0"
        }
      },
      "package": 1
    },
    {
      "name": "random",
      "types": {},
      "functions": {
        "get-random-bytes": {
          "name": "get-random-bytes",
          "kind": "freestanding",
          "params": [
            {
              "name": "max-len",
              "type": "u64"
            }
          ],
          "result": 9,
          "docs": {
            "contents": "Return up to `max-len` cryptographically-secure random or pseudo-random\nbytes.\n\nThis function must produce data at least as cryptographically secure and\nfast as an adequately seeded cryptographically-secure pseudo-random\nnumber generator (CSPRNG). It must not block, from the perspective of\nthe calling program, under any circumstances, including on the first\nrequest and on requests for numbers of bytes. The returned data must\nalways be unpredictable.\n\nImplementations MAY return fewer bytes than requested (a short read).\nCallers that require exactly `max-len` bytes MUST call this function in\na loop until the desired number of bytes has been accumulated.\nImplementations MUST return at least 1 byte when `max-len` is greater\nthan zero. When `max-len` is zero, implementations MUST return an empty\nlist without trapping.\n\nThis function must always return fresh data. Deterministic environments\nmust omit this function, rather than implementing it with deterministic\ndata."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        },
        "get-random-u64": {
          "name": "get-random-u64",
          "kind": "freestanding",
          "params": [],
          "result": "u64",
          "docs": {
            "contents": "Return a cryptographically-secure random or pseudo-random `u64` value.\n\nThis function returns the same type of data as `get-random-bytes`,\nrepresented as a `u64`."
          },
          "stability": {
            "stable": {
              "since": "0.3.0"
            }
          }
        }
      },
      "docs": {
        "contents": "WASI Random is a random data API.\n\nIt is intended to be portable at least between Unix-family platforms and\nWindows."
      },
      "stability": {
        "stable": {
          "since": "0.3.0"
        }
      },
      "package": 1
    },
